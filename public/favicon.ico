<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f43f5e" />
      <stop offset="50%" stop-color="#ec4899" />
      <stop offset="100%" stop-color="#fbbf24" />
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="1.5" stdDeviation="1.5" flood-color="#4c0519" flood-opacity="0.35" />
    </filter>
  </defs>

  <!-- Luxury Rose-to-Gold Squircle Badge -->
  <rect x="2" y="2" width="60" height="60" rx="16" fill="url(#bgGrad)" />
  <rect x="2" y="2" width="60" height="60" rx="16" stroke="#ffffff" stroke-width="1.5" stroke-opacity="0.45" />

  <!-- Ambient Twinkling Stardust -->
  <circle cx="14" cy="16" r="1.2" fill="#ffffff" opacity="0.85" />
  <circle cx="51" cy="46" r="1.4" fill="#fef08a" opacity="0.9" />
  <circle cx="13" cy="47" r="1" fill="#ffffff" opacity="0.7" />

  <!-- Princess Ammu Crown Symbol -->
  <g filter="url(#shadow)">
    <!-- Crown Body -->
    <path d="M16 41 L20 24 L27 31 L32 21 L37 31 L44 24 L48 41 Z" fill="#ffffff" />
    <!-- Crown Base Band -->
    <path d="M17 42.5 L47 42.5" stroke="#ffffff" stroke-width="3" stroke-linecap="round" />
    
    <!-- Crown Gem Jewels -->
    <circle cx="20" cy="23" r="2.2" fill="#fde047" stroke="#ffffff" stroke-width="0.5" />
    <circle cx="32" cy="20" r="2.8" fill="#fde047" stroke="#ffffff" stroke-width="0.5" />
    <circle cx="44" cy="23" r="2.2" fill="#fde047" stroke="#ffffff" stroke-width="0.5" />

    <!-- Center Heart Emblem on Crown -->
    <path d="M32 37 C32 37 28 34 28 31.2 C28 29.8 29.2 28.8 30.5 28.8 C31.3 28.8 31.8 29.3 32 29.8 C32.2 29.3 32.7 28.8 33.5 28.8 C34.8 28.8 36 29.8 36 31.2 C36 34 32 37 32 37 Z" fill="#e11d48" />
  </g>

  <!-- Radiant Celestial Star Sparkle -->
  <path d="M48 10 L49.5 14 L53.5 15.5 L49.5 17 L48 21 L46.5 17 L42.5 15.5 L46.5 14 Z" fill="#fef08a" filter="url(#shadow)" />
</svg>
